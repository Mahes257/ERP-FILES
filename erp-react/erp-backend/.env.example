# TEMPLATE — copy this file to .env and adjust for your environment.
# On Windows, setup.bat creates .env for you (checks the machine, asks for the
# MySQL login, generates the JWT secret); editing this file by hand also works.
# (Placeholder values only; never put a real secret in this tracked file.)
# Real .env files are git-ignored; .env.example stays tracked.
#
# SECURITY: ERP_JWT_SECRET, ERP_DATABASE_USERNAME and ERP_DATABASE_PASSWORD
# have NO defaults in application.properties. The backend refuses to start
# until they are provided — this is intentional.
#
# Never commit real credentials. Use placeholders in any tracked file.

# Server
ERP_PORT=8080
ERP_BASE_URL=http://localhost:8080
# Request workers / graceful shutdown (see docs/environment-configuration.md)
#ERP_TOMCAT_MAX_THREADS=200
#ERP_TOMCAT_MIN_SPARE_THREADS=25
#ERP_TOMCAT_ACCEPT_COUNT=200
#ERP_TOMCAT_MAX_CONNECTIONS=8192
#ERP_SHUTDOWN_TIMEOUT=30s

# Database — use the dedicated application user (see docs/mysql-app-user.sql),
# never MySQL root. These values point at a database that ALREADY EXISTS; the
# backend never creates one. Change HOST/PORT/NAME for the other laptop's MySQL.
ERP_DATABASE_HOST=localhost
ERP_DATABASE_PORT=3306
ERP_DATABASE_NAME=erp_db
# Optional: a full JDBC URL overrides HOST/PORT/NAME (deployments that need
# extra parameters). Uncomment and edit only if you need it.
#ERP_DATABASE_URL=jdbc:mysql://localhost:3306/erp_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
ERP_DATABASE_USERNAME=erp_app
ERP_DATABASE_PASSWORD=change-me-to-a-strong-password

# Hikari pool — 50 is the INITIAL 100-user target, not a proven optimum.
# Keep MySQL max_connections above this plus headroom (>= 120 for 50).
#ERP_DB_POOL_MAX=50
#ERP_DB_POOL_MIN_IDLE=10
#ERP_DB_POOL_CONNECTION_TIMEOUT_MS=12000
#ERP_DB_POOL_IDLE_TIMEOUT_MS=300000
#ERP_DB_POOL_MAX_LIFETIME_MS=1500000
#ERP_DB_POOL_KEEPALIVE_MS=300000
#ERP_DB_LEAK_DETECTION_MS=60000

# Authentication
# Generate with: openssl rand -base64 64
ERP_JWT_SECRET=change-me-to-a-long-random-base64-secret-at-least-64-bytes
# Access-token lifetime in ms (default 30 min = 1800000)
#ERP_JWT_EXPIRATION_MS=1800000
# Refresh-token lifetime in ms (default 7 days = 604800000)
#ERP_JWT_REFRESH_EXPIRATION_MS=604800000

# ---- Local-development auto-login (keep DISABLED everywhere except your own machine) ----
# When true AND a real existing user is configured below, opening the app on
# this machine signs that user in automatically, with a normal JWT session and
# the account's own role/permissions. The endpoint refuses non-loopback and
# proxied/tunnelled requests, so a deployed instance is never reachable this way.
# Leave false in every shared/production configuration.
ERP_LOCAL_AUTO_LOGIN_ENABLED=false
# Existing ERP account email to sign in as locally. Never a password or token.
ERP_LOCAL_AUTO_LOGIN_USER=

# CORS — the real frontend origin(s) in production (comma-separated).
#ERP_CORS_ALLOWED_ORIGINS=https://erp.example.com

# Storage / external services
ERP_UPLOAD_DIR=uploads
# Shared attachment capacity across every module (bytes). Size it to the upload
# volume minus headroom; the UI reads the same value via GET /files/storage.
#ERP_ATTACHMENT_POOL_BYTES=4294967296
# Simultaneous attachment writes, and the free-space reserve that returns 507.
#ERP_MAX_CONCURRENT_UPLOADS=4
#ERP_UPLOAD_ACQUIRE_TIMEOUT_MS=30000
#ERP_UPLOAD_MIN_FREE_BYTES=5368709120
# Actuator disk-health threshold (same volume).
#ERP_DISK_MIN_FREE_BYTES=5368709120
ERP_EXCHANGE_API_URL=https://open.er-api.com/v6/latest/{base}

# Production only — enable HSTS once HTTPS terminates in front of the app.
#ERP_SECURITY_HSTS=true
