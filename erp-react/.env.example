# Copy this file to .env and adjust for your environment.
# Real .env files are git-ignored; .env.example stays tracked.

# Browser-side API base URL (keep relative to preserve the same-origin proxy).
VITE_API_URL=/v1

# Vite dev-server proxy target — the Spring Boot backend origin.
# Example: http://localhost:8080
ERP_PROXY_TARGET=http://localhost:8080

# Google Maps API key (required for Marketing Map Test and Travel Planner).
# Enable these APIs in Google Cloud Console:
#   - Maps JavaScript API
#   - Places API
#   - Directions API
# Restrict the key to HTTP referrer http://localhost:5173/* for development.
VITE_GOOGLE_MAPS_API_KEY=your_api_key_here
